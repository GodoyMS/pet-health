{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "build": "nest build",
    "seed": "tsx src/seed.cli.ts",
    "seed:species": "tsx src/seed.cli.ts species",
    "seed:preventive-care-rules": "tsx src/seed.cli.ts preventive-care-rules",
    "seed:lifestyle-rules": "tsx src/seed.cli.ts lifestyle-rules",
    "seed:neighbours": "tsx src/seed.cli.ts neighbours",
    "seed:neighbours:clear": "tsx src/seed.cli.ts neighbours:clear",
    "seed:prod": "node dist/seed.cli.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "migration:generate": "pnpm run typeorm migration:generate",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "migration:show": "pnpm run typeorm migration:show",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/config/data-source.js migration:run",
    "migration:show:prod": "node ./node_modules/typeorm/cli.js -d dist/config/data-source.js migration:show",
    "db:baseline": "tsx src/config/baseline.cli.ts",
    "db:baseline:prod": "node dist/config/baseline.cli.js",
    "ai:generate-rules": "tsx src/preventive-care-rules/infrastructure/generate-rules.cli.ts",
    "ai:generate-lifestyle-rules": "tsx src/lifestyle-rules/infrastructure/generate-lifestyle-rules.cli.ts",
    "bootstrap:lifestyle-rules": "tsx src/lifestyle-rules/infrastructure/bootstrap-lifestyle-rules.cli.ts",
    "admin:promote": "tsx src/admin/infrastructure/promote-admin.cli.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --coverage --passWithNoTests",
    "test:run": "jest --coverage --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@repo/config-eslint": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0"
  }
}
