DATABASE_URL=
WEB_ORIGIN=
PORT=
JWT_SECRET=
NODE_ENV=

# ── Admin backoffice (apps/admin) ────────────────────────────────────────────
# Origin of the admin web app, added to the CORS allow-list.
ADMIN_ORIGIN=http://localhost:5174
# Comma-separated emails promoted to the "admin" role on API boot.
# The accounts must already exist (register in the product app first).
# You can also run: pnpm run admin:promote user@example.com
ADMIN_EMAILS=
# Required for AI wellness report generation at runtime (`POST /pets/:id/ai-reports/generate`).
# Also used by offline rule generators: `pnpm run ai:generate-rules`, `pnpm run ai:generate-lifestyle-rules`.
# Offline lifestyle fallback: `pnpm run bootstrap:lifestyle-rules`.
DEEPSEEK_API_KEY=
# Set to true on Windows/corporate networks if you see "unable to verify the first certificate" (dev only).
DEEPSEEK_INSECURE_TLS=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: {PORT}/auth/google/callback
# e.g. http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ── Google Calendar Integration ──────────────────────────────────────────────
# Uses the same Google OAuth credentials. Add the redirect URI below to
# your OAuth app's authorized redirect URIs in Google Console.
# Enable the "Google Calendar API" in your project.
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/google-calendar/callback

# ── Nearby Care map (Google Places API) ──────────────────────────────────────
# Server-side key used to proxy nearby vet/pet-store search + place photos.
# Enable "Places API (New)" for this key's project. Restrict by IP for prod.
# The browser map itself uses a SEPARATE key: VITE_GOOGLE_MAPS_API_KEY (apps/web).
GOOGLE_MAPS_API_KEY=

# -- Neighbourhood map ------------------------------------------------------
# No extra API keys are needed: nearby-pet search runs against our own
# database, and the browser map reuses VITE_GOOGLE_MAPS_API_KEY (apps/web).
# For a populated map in development, seed demo neighbours:
#   pnpm run seed:neighbours -- --lat 28.6139 --lng 77.209 --radius 1500 --count 12
#   pnpm run seed:neighbours:clear

# ── Email (AWS SES) — MFA for registration + forgot password ────────────────
# When SES_FROM_EMAIL + AWS_REGION are set, codes are sent via Amazon SES.
# Without them (or when SES rejects in non-production, e.g. sandbox), codes are
# logged to the API console and returned as previewCode for local testing.
#
# SES sandbox rules:
#   1. SES_FROM_EMAIL must be a verified identity (email or domain)
#   2. Every recipient must ALSO be a verified identity until you leave sandbox
#      (AWS Console → SES → Identities → Create identity → verify the inbox)
#   3. Or request production access to email any address
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
# Optional SES configuration set for open/click/bounce tracking.
SES_CONFIGURATION_SET=
