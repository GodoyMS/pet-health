# Rendered by the nginx image's envsubst entrypoint, which fills in ${PORT}.
# Railway injects PORT; the Dockerfile sets a default for local runs.
server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Client-side routing: a hard refresh on /pets/123 must serve index.html
    # rather than 404, and let React Router resolve the path.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits content-hashed filenames, so assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or clients keep loading stale asset refs
    # after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
