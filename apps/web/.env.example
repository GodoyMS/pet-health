VITE_API_URL=

# Browser key for the Nearby Care map (Google Maps JavaScript API).
# Enable "Maps JavaScript API" and restrict by HTTP referrer for production.
# The nearby search itself is proxied by the API (GOOGLE_MAPS_API_KEY there).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID for a custom vector map style (enables Advanced Markers).
# Falls back to Google's DEMO_MAP_ID when unset.
VITE_GOOGLE_MAPS_MAP_ID=