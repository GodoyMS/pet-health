# Rendered by the nginx image's envsubst entrypoint, which fills in ${PORT}.
# Railway injects PORT; the Dockerfile sets a default for local runs.
server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Client-side routing: a hard refresh on /admin routes must serve
    # index.html rather than 404, and let React Router resolve the path.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits content-hashed filenames, so assets can be cached forever.
    # This also covers the subsetted Material Symbols woff2, which is fetched
    # via <link rel="preload"> on every page.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or clients keep loading stale asset refs
    # after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The Docker build ships a .gz next to every compressible asset, so nginx
    # serves a level-9 file instead of gzipping each response at its default
    # level 1. `gzip on` stays as the fallback for anything not precompressed.
    gzip_static       on;
    gzip_vary         on;

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
